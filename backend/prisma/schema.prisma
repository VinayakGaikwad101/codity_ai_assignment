// Prisma Schema for Distributed Job Scheduler Platform
// Fully normalized (3NF), relational schema with strict foreign keys, indexes, and cascades.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum JobStatus {
  QUEUED
  SCHEDULED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  DEAD_LETTERED
}

enum JobType {
  IMMEDIATE
  DELAYED
  SCHEDULED
  RECURRING
  BATCH_PARENT
  BATCH_CHILD
  WORKFLOW_NODE
}

enum RetryStrategy {
  FIXED
  LINEAR
  EXPONENTIAL
}

enum WorkerStatus {
  HEALTHY
  STALE
  DEAD
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  ABANDONED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum JobHandlerType {
  HTTP_WEBHOOK
  SHELL_COMMAND
  CUSTOM_COMPUTE
  SAMPLE_EMAIL
  SAMPLE_REPORT
}

// 1. Organizations (Multi-Tenant Boundary)
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users     User[]
  projects  Project[]

  @@map("organizations")
}

// 2. Users (RBAC)
model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @unique @db.VarChar(255)
  passwordHash   String       @map("password_hash") @db.VarChar(255)
  name           String       @db.VarChar(100)
  role           UserRole     @default(OPERATOR)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

// 3. Projects
model Project {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  name           String                 @db.VarChar(100)
  slug           String                 @db.VarChar(50)
  description    String?                @db.VarChar(500)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  retryPolicies  RetryPolicy[]
  queues         Queue[]
  jobs           Job[]
  scheduledJobs  ScheduledJob[]
  dlqEntries     DeadLetterQueueEntry[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

// 4. API Keys (Machine Authentication)
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String    @db.VarChar(100)
  keyPrefix   String    @map("key_prefix") @db.VarChar(16)
  hashedKey   String    @unique @map("hashed_key") @db.VarChar(255)
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_keys")
}

// 5. Retry Policies
model RetryPolicy {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  name          String        @db.VarChar(100)
  strategy      RetryStrategy @default(EXPONENTIAL)
  maxRetries    Int           @default(3) @map("max_retries")
  baseDelayMs   Int           @default(1000) @map("base_delay_ms")
  maxDelayMs    Int           @default(60000) @map("max_delay_ms")
  jitter        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queues        Queue[]
  jobs          Job[]
  scheduledJobs ScheduledJob[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("retry_policies")
}

// 6. Queues
model Queue {
  id               String                 @id @default(uuid()) @db.Uuid
  projectId        String                 @map("project_id") @db.Uuid
  name             String                 @db.VarChar(100)
  description      String?                @db.VarChar(500)
  priority         Int                    @default(50) // 0 - 100
  concurrencyLimit Int                    @default(10) @map("concurrency_limit")
  rateLimitPerMin  Int?                   @map("rate_limit_per_min")
  isPaused         Boolean                @default(false) @map("is_paused")
  retryPolicyId    String?                @map("retry_policy_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retryPolicy      RetryPolicy?           @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  jobs             Job[]
  scheduledJobs    ScheduledJob[]
  dlqEntries       DeadLetterQueueEntry[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("queues")
}

// 7. Jobs (State Machine Core)
model Job {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @map("project_id") @db.Uuid
  queueId           String            @map("queue_id") @db.Uuid
  name              String            @db.VarChar(200)
  handlerType       JobHandlerType    @default(CUSTOM_COMPUTE) @map("handler_type")
  jobType           JobType           @default(IMMEDIATE) @map("job_type")
  status            JobStatus         @default(QUEUED)
  priority          Int               @default(50)
  payload           Json              @default("{}")
  result            Json?
  idempotencyKey    String?           @map("idempotency_key") @db.VarChar(256)
  runAt             DateTime          @default(now()) @map("run_at")
  timeoutMs         Int               @default(60000) @map("timeout_ms")
  maxRetries        Int               @default(3) @map("max_retries")
  retryCount        Int               @default(0) @map("retry_count")
  retryPolicyId     String?           @map("retry_policy_id") @db.Uuid
  parentJobId       String?           @map("parent_job_id") @db.Uuid
  scheduledJobId    String?           @map("scheduled_job_id") @db.Uuid
  claimedByWorkerId String?           @map("claimed_by_worker_id") @db.Uuid
  claimedAt         DateTime?         @map("claimed_at")
  startedAt         DateTime?         @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue             Queue             @relation(fields: [queueId], references: [id], onDelete: Cascade)
  retryPolicy       RetryPolicy?      @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  scheduledJob      ScheduledJob?     @relation(fields: [scheduledJobId], references: [id], onDelete: SetNull)
  claimedByWorker   Worker?           @relation(fields: [claimedByWorkerId], references: [id], onDelete: SetNull)
  
  parentJob         Job?              @relation("JobHierarchy", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs         Job[]             @relation("JobHierarchy")

  executions        JobExecution[]
  jobLogs           JobLog[]
  dlqEntries        DeadLetterQueueEntry[]

  // Workflow DAG Dependencies
  parentDependencies JobDependency[]  @relation("ParentJobDependencies")
  childDependencies  JobDependency[]  @relation("ChildJobDependencies")

  // Critical indexes for high-throughput FOR UPDATE SKIP LOCKED claiming and querying
  @@index([queueId, status, runAt, priority(sort: Desc)])
  @@index([status, runAt])
  @@index([projectId, status])
  @@index([claimedByWorkerId, status])
  @@unique([projectId, idempotencyKey])
  @@map("jobs")
}

// 8. Workflow Dependencies (DAG Node Edges)
model JobDependency {
  id          String   @id @default(uuid()) @db.Uuid
  parentJobId String   @map("parent_job_id") @db.Uuid
  childJobId  String   @map("child_job_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  parentJob   Job      @relation("ParentJobDependencies", fields: [parentJobId], references: [id], onDelete: Cascade)
  childJob    Job      @relation("ChildJobDependencies", fields: [childJobId], references: [id], onDelete: Cascade)

  @@unique([parentJobId, childJobId])
  @@index([childJobId])
  @@map("job_dependencies")
}

// 9. Scheduled Jobs (Recurring Cron Triggers)
model ScheduledJob {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  queueId        String         @map("queue_id") @db.Uuid
  name           String         @db.VarChar(200)
  handlerType    JobHandlerType @default(CUSTOM_COMPUTE) @map("handler_type")
  cronExpression String         @map("cron_expression") @db.VarChar(100)
  timezone       String         @default("UTC") @db.VarChar(50)
  payload        Json           @default("{}")
  priority       Int            @default(50)
  timeoutMs      Int            @default(60000) @map("timeout_ms")
  maxRetries     Int            @default(3) @map("max_retries")
  retryPolicyId  String?        @map("retry_policy_id") @db.Uuid
  isActive       Boolean        @default(true) @map("is_active")
  lastRunAt      DateTime?      @map("last_run_at")
  nextRunAt      DateTime       @map("next_run_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue          Queue          @relation(fields: [queueId], references: [id], onDelete: Cascade)
  retryPolicy    RetryPolicy?   @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  spawnedJobs    Job[]

  @@index([isActive, nextRunAt])
  @@index([projectId, queueId])
  @@map("scheduled_jobs")
}

// 10. Workers (Distributed Fleet Registry)
model Worker {
  id               String            @id @default(uuid()) @db.Uuid
  hostname         String            @db.VarChar(150)
  concurrencyLimit Int               @default(5) @map("concurrency_limit")
  activeJobsCount  Int               @default(0) @map("active_jobs_count")
  status           WorkerStatus      @default(HEALTHY)
  ipAddress        String?           @map("ip_address") @db.VarChar(50)
  version          String            @default("1.0.0") @db.VarChar(20)
  registeredAt     DateTime          @default(now()) @map("registered_at")
  lastHeartbeatAt  DateTime          @default(now()) @map("last_heartbeat_at")

  claimedJobs      Job[]
  heartbeats       WorkerHeartbeat[]
  executions       JobExecution[]

  @@index([status, lastHeartbeatAt])
  @@map("workers")
}

// 11. Worker Heartbeats (Health Telemetry)
model WorkerHeartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  cpuUsage   Float    @map("cpu_usage")
  memoryUsage Float   @map("memory_usage")
  activeJobs Int      @map("active_jobs")
  recordedAt DateTime @default(now()) @map("recorded_at")

  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, recordedAt(sort: Desc)])
  @@map("worker_heartbeats")
}

// 12. Job Executions (Attempt Audit Log)
model JobExecution {
  id            String          @id @default(uuid()) @db.Uuid
  jobId         String          @map("job_id") @db.Uuid
  attemptNumber Int             @map("attempt_number")
  workerId      String          @map("worker_id") @db.Uuid
  status        ExecutionStatus @default(RUNNING)
  startedAt     DateTime        @default(now()) @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  durationMs    Int?            @map("duration_ms")
  errorMessage  String?         @map("error_message") @db.Text
  errorStack    String?         @map("error_stack") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")

  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker        Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  logs          JobLog[]

  @@index([jobId, attemptNumber])
  @@index([workerId, status])
  @@map("job_executions")
}

// 13. Job Logs (Streaming Execution Output)
model JobLog {
  id             String       @id @default(uuid()) @db.Uuid
  jobExecutionId String       @map("job_execution_id") @db.Uuid
  jobId          String       @map("job_id") @db.Uuid
  level          LogLevel     @default(INFO)
  message        String       @db.Text
  metadata       Json?
  timestamp      DateTime     @default(now())

  execution      JobExecution @relation(fields: [jobExecutionId], references: [id], onDelete: Cascade)
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobExecutionId, timestamp])
  @@index([jobId, timestamp])
  @@map("job_logs")
}

// 14. Dead Letter Queue (DLQ for Exhausted Failures)
model DeadLetterQueueEntry {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @map("job_id") @db.Uuid
  queueId         String    @map("queue_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  originalPayload Json      @map("original_payload")
  failureReason   String    @map("failure_reason") @db.Text
  errorDetails    Json?     @map("error_details")
  totalAttempts   Int       @map("total_attempts")
  deadLetteredAt  DateTime  @default(now()) @map("dead_lettered_at")
  replayedAt      DateTime? @map("replayed_at")
  replayedJobId   String?   @map("replayed_job_id") @db.Uuid

  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  queue           Queue     @relation(fields: [queueId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, queueId, deadLetteredAt])
  @@map("dead_letter_queue")
}
