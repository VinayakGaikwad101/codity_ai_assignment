datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum JobStatus {
  QUEUED
  SCHEDULED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTERED
  CANCELLED
}

enum JobType {
  IMMEDIATE
  DELAYED
  SCHEDULED
  CRON
  BATCH_PARENT
  BATCH_CHILD
  WORKFLOW_NODE
}

enum RetryStrategy {
  FIXED
  LINEAR
  EXPONENTIAL
}

enum WorkerStatus {
  HEALTHY
  DEGRADED
  OFFLINE
  DRAINING
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  projects  Project[]
  apiKeys   ApiKey[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  name           String
  passwordHash   String
  role           UserRole     @default(OPERATOR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  keyPrefix      String       // First 8 chars for identification
  keyHash        String       @unique // SHA-256 hashed secret
  role           UserRole     @default(OPERATOR)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues         Queue[]
  jobs           Job[]
  scheduledJobs  ScheduledJob[]
  retryPolicies  RetryPolicy[]
  dlqEntries     DeadLetterQueueEntry[]
  apiKeys        ApiKey[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

model RetryPolicy {
  id                String        @id @default(uuid())
  projectId         String
  name              String
  strategy          RetryStrategy @default(EXPONENTIAL)
  maxRetries        Int           @default(3)
  initialIntervalMs Int           @default(1000)
  maxIntervalMs     Int           @default(60000)
  backoffMultiplier Float         @default(2.0)
  useJitter         Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queues            Queue[]
  jobs              Job[]
  scheduledJobs     ScheduledJob[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("retry_policies")
}

model Queue {
  id               String        @id @default(uuid())
  projectId        String
  name             String
  description      String?
  priority         Int           @default(50) // 0-100 (Higher = Higher precedence)
  concurrencyLimit Int           @default(10)
  rateLimitPerMin  Int?
  isPaused         Boolean       @default(false)
  retryPolicyId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retryPolicy      RetryPolicy?  @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  jobs             Job[]
  scheduledJobs    ScheduledJob[]
  dlqEntries       DeadLetterQueueEntry[]

  @@unique([projectId, name])
  @@index([projectId, isPaused, priority(sort: Desc)])
  @@map("queues")
}

model Job {
  id                String       @id @default(uuid())
  projectId         String
  queueId           String
  name              String
  handlerType       String
  jobType           JobType      @default(IMMEDIATE)
  status            JobStatus    @default(QUEUED)
  priority          Int          @default(50)
  payload           Json         @default("{}")
  result            Json?
  idempotencyKey    String?
  runAt             DateTime     @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  timeoutMs         Int          @default(60000)
  retryCount        Int          @default(0)
  maxRetries        Int          @default(3)
  retryPolicyId     String?
  parentJobId       String?
  claimedByWorkerId String?
  claimedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue             Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  retryPolicy       RetryPolicy? @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  parentJob         Job?         @relation("BatchHierarchy", fields: [parentJobId], references: [id], onDelete: Cascade)
  childJobs         Job[]        @relation("BatchHierarchy")
  claimedByWorker   Worker?      @relation(fields: [claimedByWorkerId], references: [id], onDelete: SetNull)

  executions        JobExecution[]
  jobLogs           JobLog[]
  parentDependencies JobDependency[] @relation("ChildJobDeps")
  childDependencies  JobDependency[] @relation("ParentJobDeps")
  dlqEntries        DeadLetterQueueEntry[]
  spawnedFromScheduled ScheduledJob? @relation("SpawnedJobs", fields: [parentJobId], references: [id], map: "job_scheduled_parent_fkey")

  @@unique([projectId, idempotencyKey])
  // High-performance composite index optimized for atomic PostgreSQL SKIP LOCKED poller queries
  @@index([queueId, status, runAt, priority(sort: Desc)])
  @@index([status, runAt])
  @@index([claimedByWorkerId, status])
  @@map("jobs")
}

model JobDependency {
  id          String   @id @default(uuid())
  parentJobId String
  childJobId  String
  createdAt   DateTime @default(now())

  parentJob   Job      @relation("ParentJobDeps", fields: [parentJobId], references: [id], onDelete: Cascade)
  childJob    Job      @relation("ChildJobDeps", fields: [childJobId], references: [id], onDelete: Cascade)

  @@unique([parentJobId, childJobId])
  @@index([childJobId])
  @@index([parentJobId])
  @@map("job_dependencies")
}

model JobExecution {
  id            String          @id @default(uuid())
  jobId         String
  workerId      String
  attemptNumber Int
  status        ExecutionStatus @default(RUNNING)
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  errorMessage  String?
  errorStack    String?

  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker        Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  logs          JobLog[]

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt(sort: Desc)])
  @@index([workerId, startedAt])
  @@map("job_executions")
}

model JobLog {
  id          String        @id @default(uuid())
  jobId       String
  executionId String?
  level       LogLevel      @default(INFO)
  message     String
  metadata    Json?
  timestamp   DateTime      @default(now())

  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  execution   JobExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([jobId, timestamp(sort: Asc)])
  @@index([executionId])
  @@map("job_logs")
}

model ScheduledJob {
  id             String       @id @default(uuid())
  projectId      String
  queueId        String
  name           String
  handlerType    String
  cronExpression String
  timezone       String       @default("UTC")
  payload        Json?        @default("{}")
  priority       Int          @default(50)
  timeoutMs      Int          @default(60000)
  maxRetries     Int          @default(3)
  retryPolicyId  String?
  isActive       Boolean      @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  retryPolicy    RetryPolicy? @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  spawnedJobs    Job[]        @relation("SpawnedJobs")

  @@index([projectId])
  @@index([isActive, nextRunAt(sort: Asc)])
  @@map("scheduled_jobs")
}

model DeadLetterQueueEntry {
  id              String   @id @default(uuid())
  projectId       String
  queueId         String
  jobId           String
  failureReason   String
  stackTrace      String?
  totalAttempts   Int
  originalPayload Json
  deadLetteredAt  DateTime @default(now())
  replayedAt      DateTime?
  replayedJobId   String?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue           Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([projectId, deadLetteredAt(sort: Desc)])
  @@index([queueId])
  @@index([jobId])
  @@map("dead_letter_queue_entries")
}

model Worker {
  id                String            @id @default(uuid())
  hostname          String
  ipAddress         String?
  status            WorkerStatus      @default(HEALTHY)
  concurrencyLimit  Int               @default(10)
  activeJobsCount   Int               @default(0)
  lastHeartbeatAt   DateTime          @default(now())
  startedAt         DateTime          @default(now())

  claimedJobs       Job[]
  executions        JobExecution[]
  heartbeats        WorkerHeartbeat[]

  @@index([status, lastHeartbeatAt])
  @@map("workers")
}

model WorkerHeartbeat {
  id          String   @id @default(uuid())
  workerId    String
  cpuUsage    Float
  memoryUsage Float
  activeJobs  Int
  timestamp   DateTime @default(now())

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, timestamp(sort: Desc)])
  @@map("worker_heartbeats")
}
