meta {
  name: 03. Generate Machine API Key
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/api-keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Stripe Webhook Ingestion Key",
    "role": "OPERATOR",
    "expiresInDays": 90
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.rawKey) {
    bru.setEnvVar("apiKey", res.body.data.rawKey);
  }
}
