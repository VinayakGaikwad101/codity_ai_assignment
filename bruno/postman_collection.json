    {
      "name": "05-Jobs",
      "item": [
        {
          "name": "01. Ingest Immediate Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"queueId\": \"{{queueId}}\",\n  \"name\": \"Settle Ledger Transaction TX_8801\",\n  \"handlerType\": \"LEDGER_SETTLEMENT\",\n  \"jobType\": \"IMMEDIATE\",\n  \"priority\": 95,\n  \"payload\": {\n    \"account\": \"ACC_9921\",\n    \"amount\": 1450.75,\n    \"currency\": \"USD\"\n  },\n  \"idempotencyKey\": \"tx_8801_settle_v1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "02. Ingest Delayed Job (10s Delay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"queueId\": \"{{queueId}}\",\n  \"name\": \"Delayed Audit Notification\",\n  \"handlerType\": \"SEND_NOTIFICATION\",\n  \"jobType\": \"DELAYED\",\n  \"delayMs\": 10000,\n  \"payload\": {\n    \"recipient\": \"finance@acme.com\",\n    \"reportId\": \"rep_991\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "03. Ingest Batch Jobs (5 Child Items)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"queueId\": \"{{queueId}}\",\n  \"batchName\": \"Morning KYC Verification Batch\",\n  \"jobs\": [\n    { \"name\": \"Verify User 101 KYC\", \"handlerType\": \"KYC_VERIFY\", \"payload\": { \"userId\": \"u101\" } },\n    { \"name\": \"Verify User 102 KYC\", \"handlerType\": \"KYC_VERIFY\", \"payload\": { \"userId\": \"u102\" } },\n    { \"name\": \"Verify User 103 KYC\", \"handlerType\": \"KYC_VERIFY\", \"payload\": { \"userId\": \"u103\" } },\n    { \"name\": \"Verify User 104 KYC\", \"handlerType\": \"KYC_VERIFY\", \"payload\": { \"userId\": \"u104\" } },\n    { \"name\": \"Verify User 105 KYC\", \"handlerType\": \"KYC_VERIFY\", \"payload\": { \"userId\": \"u105\" } }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/batch",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "batch"]
            }
          }
        },
        {
          "name": "04. Ingest Deterministic Failing Job (Retry & DLQ Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"queueId\": \"{{queueId}}\",\n  \"name\": \"Unstable Payment Webhook Dispatch\",\n  \"handlerType\": \"FAILING_TASK\",\n  \"jobType\": \"IMMEDIATE\",\n  \"priority\": 80,\n  \"payload\": {\n    \"failUntilAttempt\": 5,\n    \"errorMessage\": \"Payment gateway returned 503 Service Unavailable\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
