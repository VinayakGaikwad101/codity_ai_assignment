    {
      "name": "03-RetryPolicies",
      "item": [
        {
          "name": "01. Create Exponential Retry Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"Payment Webhook Exponential Backoff\",\n  \"strategy\": \"EXPONENTIAL\",\n  \"maxRetries\": 3,\n  \"initialIntervalMs\": 1000,\n  \"maxIntervalMs\": 30000,\n  \"backoffMultiplier\": 2.0,\n  \"useJitter\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/retry-policies",
              "host": ["{{baseUrl}}"],
              "path": ["retry-policies"]
            }
          }
        },
