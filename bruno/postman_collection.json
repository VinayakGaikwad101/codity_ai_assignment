              "host": ["{{baseUrl}}"],
              "path": ["queues"]
            }
          }
        },
        {
          "name": "03. Pause Queue Execution Gate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
