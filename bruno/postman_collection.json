    {
      "name": "03-RetryPolicies",
      "item": [
        {
          "name": "01. Create Exponential Retry Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"Payment Webhook Exponential Backoff\",\n  \"strategy\": \"EXPONENTIAL\",\n  \"maxRetries\": 3,\n  \"initialIntervalMs\": 1000,\n  \"maxIntervalMs\": 30000,\n  \"backoffMultiplier\": 2.0,\n  \"useJitter\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/retry-policies",
              "host": ["{{baseUrl}}"],
              "path": ["retry-policies"]
            }
          }
        },
        {
          "name": "02. List Retry Policies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/retry-policies",
              "host": ["{{baseUrl}}"],
              "path": ["retry-policies"]
            }
          }
        }
      ]
    },
    {
      "name": "04-Queues",
      "item": [
        {
          "name": "01. Create High-Priority Queue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"instant-settlements\",\n  \"description\": \"Real-time bank ledger settlement transactions\",\n  \"priority\": 95,\n  \"concurrencyLimit\": 20,\n  \"rateLimitPerMin\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/queues",
              "host": ["{{baseUrl}}"],
              "path": ["queues"]
            }
          }
        },
        {
          "name": "02. List All Queues with Live Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/queues",
              "host": ["{{baseUrl}}"],
              "path": ["queues"]
            }
          }
        },
        {
          "name": "03. Pause Queue Execution Gate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPaused\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/queues/{{queueId}}/pause",
              "host": ["{{baseUrl}}"],
              "path": ["queues", "{{queueId}}", "pause"]
            }
          }
        },
        {
          "name": "04. Resume Queue Execution Gate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPaused\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/queues/{{queueId}}/pause",
              "host": ["{{baseUrl}}"],
              "path": ["queues", "{{queueId}}", "pause"]
            }
          }
        },
