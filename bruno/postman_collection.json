            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPaused\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/queues/{{queueId}}/pause",
              "host": ["{{baseUrl}}"],
              "path": ["queues", "{{queueId}}", "pause"]
            }
          }
        },
