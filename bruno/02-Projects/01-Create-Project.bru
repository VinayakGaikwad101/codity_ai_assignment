meta {
  name: 01. Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Payment Gateway Pipeline",
    "description": "Asynchronous payment webhooks and settlement jobs"
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("projectId", res.body.data.id);
  }
}
